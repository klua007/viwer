# ---------------------------------------------------------------------------
# Viewer — npm configuration
#
# ignore-scripts=true
#   Segurança (supply-chain): nenhum pacote pode executar scripts durante a
#   instalação. O pacote @lucasmod/boruto-vk7-baileys possui um script
#   `preinstall` quebrado no tarball publicado (aponta para um arquivo que
#   não é distribuído); ignorar scripts também contorna essa falha sem
#   prejudicar nenhuma dependência real do Viewer (nenhuma requer build em
#   pós-instalação). A verificação de versão do Node é refeita pelo doctor.sh.
# ---------------------------------------------------------------------------
ignore-scripts=true
